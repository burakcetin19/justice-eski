justice/tracking/snapshot/best.pt
# TCTrack model (~114MB)
justice/tracking/snapshot/TCTrack.pth

# ---- Diğer büyük dizinler ----
Meryem_GPS/

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
